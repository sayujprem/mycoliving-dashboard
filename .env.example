# Clave del API de Anthropic. Solo se necesita para el informe mensual de asesoria.
ANTHROPIC_API_KEY=

# Requerido solo si tu API key esta ligada a una identidad con workspaces (formato wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Opcional: ruta del archivo SQLite. Por defecto: mycoliving.db en la raiz del proyecto.
MYCOLIVING_DB_PATH=
