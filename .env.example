# --- Obligatorias: sin ellas la aplicación no arranca ---

# PostgreSQL. En local: la que imprime `scripts/pg_local.sh url`.
# En producción: el transaction pooler de Supabase (puerto 6543).
DATABASE_URL=postgresql://postgres@localhost:54329/mycoliving

# Firma de la cookie de sesión. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# --- Opcionales ---

# "produccion" activa la cookie Secure y HSTS. En local se deja vacío: sin HTTPS, el
# navegador descartaría la cookie y no se podría iniciar sesión.
MYCOLIVING_ENTORNO=

# URL pública, para los enlaces de los correos. En local no hace falta.
APP_URL=http://127.0.0.1:8000

# Correo por el SMTP de Gmail. Sin clave, los enlaces se imprimen en la terminal en vez
# de enviarse. SMTP_CLAVE es una contraseña de aplicación de Google, no la de la cuenta.
SMTP_USUARIO=privacidad.mycoliving@gmail.com
SMTP_CLAVE=

# Asesoría con IA. El resto de la plataforma funciona sin ella.
ANTHROPIC_API_KEY=
# Solo si la API key está ligada a un workspace (formato wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# Modelo. Por defecto claude-sonnet-5.
MYCOLIVING_MODELO=
